# Copy values into your shell session. Do not commit a populated .env file.
LINEAR_API_KEY=
OPENSYMPHONY_HARNESS=codex_app_server
OPENSYMPHONY_MODEL=gpt-5.5
OPENSYMPHONY_MODEL_PROFILE=codex-chatgpt-local-keychain

# Expo/PWA public backend origin (no trailing slash). This is not a secret.
EXPO_PUBLIC_FIELD_API_URL=http://localhost:3000

# Backend-only configuration. Never expose these values through EXPO_PUBLIC_*.
INTERNAL_API_ENABLED=false
INTERNAL_API_TOKEN=replace-with-at-least-32-random-bytes
INTERNAL_API_ALLOW_NO_TOKEN=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/1000_ojos
FIELD_MEDIA_DIR=/absolute/path/to/private-field-media
FIELD_ALLOWED_ORIGINS=http://localhost:8081
