{
  "name": "@1000-ojos/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:railway": "npm run migrate:field && next start -p ${PORT:-3000} -H 0.0.0.0",
    "migrate:field": "node scripts/migrate-field-storage.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.mts",
    "test:integration": "node --import tsx --test tests/integration/*.test.mts"
  },
  "dependencies": {
    "@1000-ojos/contracts": "1.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "pg": "^8.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "engines": { "node": ">=20" }
}
